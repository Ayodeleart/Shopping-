    {
      "source": "/api/check-slug",
      "destination": "/api/vendor?fn=check-slug"
    },
    {
      "source": "/api/verify-identity",
      "destination": "/api/vendor?fn=verify-identity"
    },
    {
      "source": "/api/verify-bank",
      "destination": "/api/vendor?fn=verify-bank"
    },
    {
      "source": "/api/brand-search",
      "destination": "/api/lookup?fn=brand-search"
    },
    {
      "source": "/api/geocode",
      "destination": "/api/lookup?fn=geocode"

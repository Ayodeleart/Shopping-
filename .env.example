# Copy these into Vercel > Project Settings > Environment Variables. Never commit real values.

# ---- AI (new) ----
GROQ_API_KEY=                     # server only; https://console.groq.com/keys
GROQ_TEXT_MODEL=openai/gpt-oss-120b        # chat + product text + tool calling
GROQ_VISION_MODEL=qwen/qwen3.6-27b         # product photos (must accept image input)
# GROQ_REASONING_EFFORT=low       # optional: low | medium | high for gpt-oss, none | default for qwen
# GROQ_BASE_URL=                  # optional override (tests / proxy)
# AI_SIGNING_SECRET=              # optional; defaults to a key derived from SUPABASE_SERVICE_ROLE_KEY

# ---- already used by the existing API routes ----
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_EMAIL=                      # comma separated admin emails
SITE_URL=                         # e.g. https://your-store.vercel.app
LOGO_DEV_SECRET_KEY=
LOGO_DEV_PUBLISHABLE_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT_EMAIL=
RESEND_API_KEY=
EMAIL_FROM=
CRON_SECRET=
